# Model weights — safety net for *.pt/*.pth wherever they end up, not just
# results/checkpoints/. Found models/best_model_v3.pt (68MB) sitting outside
# that folder, which the rule below alone wouldn't have caught.
results/checkpoints/
results/logs/
*.pt
*.pth

# Dataset (not ours to share)
data/raw/
data/processed/
data/manifests/
images/
extreme_cases/
upload_images/
tta_validation*/
finetune_v5_sample/

# Runtime data — NOT source code, and monitoring.db has been multiple GB.
# A careless `git add .` here would try to commit a live production
# database (with embedded base64 image blobs) into git history.
monitoring.db
monitoring.db-journal
*.db
*.db-journal
logs/

# Vendor / dependencies
vendor/

# Not for repo — personal working docs, not part of the app
notebooks/
evaluation/demo.py
risk_assessment/report_generator.py
supervisor_*.docx
~$*.docx
upload_ready/

# Secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Node (Flood Watcher React app) — regenerated by `npm install`
node_modules/
Flood Watcher/node_modules/
Flood Watcher (1)/node_modules/
.vite/
dist/

# Mac
.DS_Store

# Jupyter
.ipynb_checkpoints/

# iCloud
*.icloud

# Not for the public repo — thesis/admin documents, meeting notes, one-off
# review dumps, cluster job scripts, and machine-specific service files.
# Reviewed and confirmed with the user before pushing to GitHub.
*.docx
*.pdf
.Rhistory
writing/
sample_check/
v4_mistake_review/
drainwatch_demo_script.md
slurm/
scripts/*.plist
